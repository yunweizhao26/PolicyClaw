{
 "about": "The fixed vocabulary of the representation. Operations form a tree rooted at processing, as GDPR Art. 4(2) defines it; policy verbs are placed under them from data. Code reads this file and contains no policy words. Every entry names its source. Version 2 adds legal bases, transfer safeguards, processing location, and retention time. Version 3 adds value types: places as a tree, integer bounds, and units.",
 "operations": {
  "processing": {
   "parent": null,
   "gloss": "any operation performed on personal data",
   "source": "GDPR Art. 4(2)"
  },
  "collection": {
   "parent": "processing",
   "gloss": "obtaining personal data from the user, a device, or another source",
   "source": "GDPR Art. 4(2)"
  },
  "recording": {
   "parent": "processing",
   "gloss": "recording or logging observations about the user as they happen",
   "source": "GDPR Art. 4(2)"
  },
  "organisation": {
   "parent": "processing",
   "gloss": "arranging data into records or profiles",
   "source": "GDPR Art. 4(2)"
  },
  "structuring": {
   "parent": "processing",
   "gloss": "putting data into a structure such as a database",
   "source": "GDPR Art. 4(2)"
  },
  "storage": {
   "parent": "processing",
   "gloss": "keeping data for a period",
   "source": "GDPR Art. 4(2)"
  },
  "adaptation or alteration": {
   "parent": "processing",
   "gloss": "changing, correcting, or transforming data",
   "source": "GDPR Art. 4(2)"
  },
  "retrieval": {
   "parent": "processing",
   "gloss": "getting stored data back out of storage",
   "source": "GDPR Art. 4(2)"
  },
  "consultation": {
   "parent": "processing",
   "gloss": "looking at or viewing data",
   "source": "GDPR Art. 4(2)"
  },
  "use": {
   "parent": "processing",
   "gloss": "using data for a purpose, including analysis and communication with the user",
   "source": "GDPR Art. 4(2)"
  },
  "disclosure": {
   "parent": "processing",
   "gloss": "disclosure by transmission, dissemination, or otherwise making data available to others",
   "source": "GDPR Art. 4(2)"
  },
  "disclosure by transmission": {
   "parent": "disclosure",
   "gloss": "sending or transferring data to a specific recipient",
   "source": "GDPR Art. 4(2)"
  },
  "dissemination or otherwise making available": {
   "parent": "disclosure",
   "gloss": "publishing data or making it visible or accessible to others or the public",
   "source": "GDPR Art. 4(2)"
  },
  "alignment or combination": {
   "parent": "processing",
   "gloss": "linking or combining data from different sources",
   "source": "GDPR Art. 4(2)"
  },
  "restriction": {
   "parent": "processing",
   "gloss": "marking stored data to limit its future processing",
   "source": "GDPR Art. 4(2) and 4(3)"
  },
  "erasure or destruction": {
   "parent": "processing",
   "gloss": "deleting, anonymising, or destroying data",
   "source": "GDPR Art. 4(2)"
  },
  "profiling": {
   "parent": "processing",
   "gloss": "automated evaluation or prediction of personal aspects",
   "source": "GDPR Art. 4(4)"
  },
  "sale": {
   "parent": "disclosure by transmission",
   "gloss": "disclosing data for money or other valuable consideration",
   "source": "CCPA Cal. Civ. Code 1798.140"
  }
 },
 "variables": [
  {
   "name": "user.age",
   "kind": "int",
   "gloss": "the user's age in years",
   "min": 0,
   "max": 130,
   "unit": "years"
  },
  {
   "name": "user.parental_consent",
   "kind": "bool",
   "gloss": "a parent or guardian consented"
  },
  {
   "name": "user.jurisdiction",
   "kind": "category",
   "gloss": "a country, state, or region, such as \"California\" or \"EEA\"",
   "value_set": "place"
  },
  {
   "name": "user.category",
   "kind": "category",
   "gloss": "the user's relation to the company, such as \"customer\", \"job applicant\", or \"website visitor\""
  },
  {
   "name": "service",
   "kind": "category",
   "gloss": "the product, website, app, or feature concerned"
  },
  {
   "name": "consent.*",
   "kind": "bool",
   "gloss": "the user consented to the named use, such as consent.marketing_emails"
  },
  {
   "name": "opt_in.*",
   "kind": "bool",
   "gloss": "the user opted in to the named use"
  },
  {
   "name": "opt_out.*",
   "kind": "bool",
   "gloss": "the user opted out of the named use, such as opt_out.targeted_ads"
  },
  {
   "name": "setting.*",
   "kind": "bool",
   "gloss": "a setting or tool the user controls is in the named state"
  },
  {
   "name": "event.*",
   "kind": "bool",
   "closed_world": true,
   "gloss": "the named event happened, such as event.merger or event.purchase"
  },
  {
   "name": "request.*",
   "kind": "bool",
   "closed_world": true,
   "gloss": "the user made the named request, such as request.delete"
  },
  {
   "name": "law.required",
   "kind": "bool",
   "closed_world": true,
   "gloss": "law or legal process requires the practice"
  },
  {
   "name": "law.permitted",
   "kind": "bool",
   "closed_world": true,
   "gloss": "law or legal process permits the practice"
  },
  {
   "name": "basis.*",
   "kind": "bool",
   "gloss": "the company relies on the named legal basis: basis.consent, basis.contract, basis.legal_obligation, basis.vital_interests, basis.public_task, or basis.legitimate_interests",
   "source": "GDPR Art. 6(1)(a) to (f)"
  },
  {
   "name": "transfer.*",
   "kind": "bool",
   "gloss": "a transfer to another country relies on the named safeguard: transfer.adequacy_decision, transfer.standard_contractual_clauses, transfer.binding_corporate_rules, transfer.certification (such as the EU-U.S. Data Privacy Framework or the former Privacy Shield), or transfer.derogation (such as explicit consent)",
   "source": "GDPR Chapter V, Art. 45 to 49"
  },
  {
   "name": "processing.location",
   "kind": "category",
   "gloss": "the country or region where the data is stored or processed, such as \"United States\"",
   "source": "GDPR Chapter V",
   "value_set": "place"
  },
  {
   "name": "retention.days",
   "kind": "int",
   "gloss": "how long the data has been kept, in days; \"for 6 months\" limits retention.days to at most 180",
   "source": "GDPR Art. 5(1)(e) and 13(2)(a), CCPA 1798.100(a)(3)",
   "min": 0,
   "max": 36500,
   "unit": "days"
  },
  {
   "name": "policy.permits",
   "kind": "bool",
   "derived": true,
   "gloss": "another part of this policy permits the practice; the exception of a prohibition that points to the policy itself, such as \"except as set forth in this Policy\"",
   "source": "derived in each decision from the policy's own permissions for the same practice"
  }
 ],
 "closed_world_note": "A scenario describes what happened, so an event, request, or legal requirement that it does not mention did not happen. Facts about the user stay unknown when unstated.",
 "axioms": [
  {
   "formula": {
    "op": "cmp",
    "var": "user.age",
    "cmp": ">=",
    "value": 0
   },
   "source": "ages are non-negative"
  },
  {
   "scope_of": [
    "consent.*",
    "opt_in.*",
    "opt_out.*"
   ],
   "formula": {
    "op": "or",
    "args": [
     {
      "op": "not",
      "arg": {
       "op": "bool",
       "var": "opt_out.{x}"
      }
     },
     {
      "op": "not",
      "arg": {
       "op": "bool",
       "var": "opt_in.{x}"
      }
     }
    ]
   },
   "source": "opting out of a use excludes being opted in to it"
  },
  {
   "scope_of": [
    "consent.*",
    "opt_in.*",
    "opt_out.*"
   ],
   "formula": {
    "op": "or",
    "args": [
     {
      "op": "not",
      "arg": {
       "op": "bool",
       "var": "opt_in.{x}"
      }
     },
     {
      "op": "bool",
      "var": "consent.{x}"
     }
    ]
   },
   "source": "opting in to a use is consent to it"
  },
  {
   "formula": {
    "op": "cmp",
    "var": "retention.days",
    "cmp": ">=",
    "value": 0
   },
   "source": "durations are non-negative"
  }
 ],
 "uncovered": {
  "label": "other",
  "parent": "processing",
  "gloss": "an operation on personal data that none of the operations above describes"
 },
